{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marklab",
  "version": "0.2.8",
  "identifier": "app.marklab.tauri.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost marklab-asset: http://marklab-asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost marklab-asset: http://marklab-asset.localhost; worker-src 'self' blob:; media-src 'self' asset: http://asset.localhost marklab-asset: http://marklab-asset.localhost blob:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icons/marklab.png",
      "../resources/icons/marklab-32.png",
      "../resources/icons/marklab-48.png",
      "../resources/icons/marklab-128.png",
      "../resources/icons/marklab-256.png",
      "../resources/icons/marklab-512.png",
      "../resources/icons/marklab.icns",
      "../resources/icons/marklab.ico"
    ],
    "resources": {
      "../resources/workspace-guide/": "workspace-guide/",
      "../resources/licenses/": "licenses/"
    },
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["puml", "plantuml", "pu", "wsd", "iuml"],
        "name": "PlantUML Document",
        "role": "Editor"
      },
      {
        "ext": ["mmd", "mermaid"],
        "name": "Mermaid Document",
        "role": "Editor"
      },
      {
        "ext": ["csv", "tsv", "html", "htm"],
        "name": "Source Document",
        "role": "Editor"
      },
      {
        "ext": ["xlsx", "xlsm"],
        "name": "Spreadsheet",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["marklab"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
