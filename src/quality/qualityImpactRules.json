[
  {
    "area": "Tauri native runtime",
    "risk": "workspace isolation, save integrity, window lifecycle, native permissions, or cache invalidation regression",
    "patterns": [
      "^src-tauri/",
      "^src/runtime/tauri/",
      "^src/runtime/assetUrl",
      "^scripts/build-renderer",
      "^scripts/prepare-tauri-release"
    ],
    "checks": [
      "pnpm tauri:check",
      "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
      "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
      "pnpm tauri:test",
      "native multi-window/edit/save/splash acceptance"
    ]
  },
  {
    "area": "Native menus / windows",
    "risk": "double dispatch, unsafe desktop capability, or platform-specific runtime drift",
    "patterns": [
      "^src-tauri/src/desktop/",
      "^src-tauri/src/native_window",
      "^src/app/useAppMenuAction",
      "^src/components/WindowControls"
    ],
    "checks": [
      "native lifecycle/menu tests",
      "focused edit tests",
      "native window smoke checks",
      "pnpm typecheck",
      "pnpm lint"
    ]
  },
  {
    "area": "Source editor / Monaco",
    "risk": "duplicated edit commands, option drift, focus routing, or source navigation regression",
    "patterns": [
      "^src/app/focusedEditCommand",
      "^src/components/SourceCodeEditor",
      "^src/components/markdownSource",
      "^src/components/sourceCodeContextMenu",
      "^src/lib/focusedCodeEditor",
      "^src/logic/sourceLanguages",
      "^src/pages/Source"
    ],
    "checks": ["source editor tests", "focused edit tests", "pnpm typecheck"]
  },
  {
    "area": "WYSIWYG / Plate",
    "risk": "command mismatch, paste/drop regression, editor sync drift, or node-view breakage",
    "patterns": [
      "^src/components/MarkdownEditor",
      "^src/components/plate/",
      "^src/components/editor/",
      "^src/components/markdown/",
      "^src/components/previews/(DiagramPreviewDialog|EmbeddedPreviewDialog|MermaidPreview|ZoomableVisualViewport)",
      "^src/styles/plate-editor",
      "^src/styles/source-editor",
      "^e2e/performance/",
      "^playwright\\.renderer\\.config\\.ts$",
      "^\\.github/workflows/performance\\.yml$",
      "^e2e/renderer/"
    ],
    "checks": [
      "Plate command/paste/sync tests",
      "preview/zoom tests",
      "pnpm test:perf:software",
      "pnpm typecheck"
    ]
  },
  {
    "area": "React Flow graph",
    "risk": "default node renderer fallback, drag/selection conflict, or graph model drift",
    "patterns": [
      "^src/components/GraphRichNodes",
      "^src/components/GraphWebNode",
      "^src/logic/graph",
      "^src/logic/workspaceGraphRevision",
      "^src/logic/workspaceMapGraph",
      "^src/pages/WorkspaceGraphPage",
      "^src/pages/graph",
      "^src/pages/workspace-map",
      "^src/styles/app/_graph",
      "^src/styles/graph"
    ],
    "checks": ["graph logic tests", "workspace map tests", "graph interaction style tests"]
  },
  {
    "area": "Settings / persisted preferences",
    "risk": "default drift, missing persisted field, inaccessible control, or migration mismatch",
    "patterns": [
      "^src-tauri/src/settings/",
      "^src/components/settings/",
      "^src/components/SettingsDialog",
      "^src/store/preferences",
      "^src/store/usePreferencesStore"
    ],
    "checks": [
      "Rust settings/session isolation tests",
      "settings tests",
      "affected component option tests",
      "pnpm typecheck"
    ]
  },
  {
    "area": "Keyboard shortcuts",
    "risk": "missing default binding, untranslated shortcut action, settings drift, or unhandled scoped shortcut",
    "patterns": [
      "^src/logic/shortcuts",
      "^src/app/useKeyboardShortcuts",
      "^src/pages/workspace-map/useWorkspaceMapKeyboard",
      "^src/components/settings/Shortcut",
      "^src/components/settings/ShortcutsSettingsPage",
      "^src/components/editor/editorCommandCatalog",
      "^src/components/plate/plateEditorShortcuts"
    ],
    "checks": [
      "shortcut catalog tests",
      "shortcut settings tests",
      "workspace map/editor shortcut tests",
      "pnpm typecheck"
    ]
  },
  {
    "area": "IPC / runtime services",
    "risk": "stringly payloads, broad capability exposure, or renderer/runtime contract drift",
    "patterns": [
      "^src-tauri/capabilities/",
      "^src-tauri/src/native_window",
      "^src-tauri/src/.+/commands\\.rs$",
      "^src-tauri/src/desktop/invoke",
      "^src/runtime/",
      "^src/services/.+Api"
    ],
    "checks": ["runtime/service contract tests", "native IPC capability tests", "pnpm typecheck"]
  },
  {
    "area": "Workspace filesystem/services",
    "risk": "workspace binding drift, path normalization mismatch, save conflicts, watcher invalidation, or asset access bug",
    "patterns": ["^src-tauri/src/workspace/", "^src-tauri/src/assets/", "^src-tauri/src/history/"],
    "checks": [
      "Rust workspace/history/asset tests",
      "native multi-window save/restore smoke checks",
      "pnpm typecheck"
    ]
  },
  {
    "area": "Knowledge engine / Rust analysis",
    "risk": "workspace isolation drift, blocking I/O, index mismatch, or runtime lifecycle regression",
    "patterns": ["^src-tauri/src/analysis/", "^src-tauri/src/language/", "^src-tauri/src/mcp/"],
    "checks": [
      "Rust analysis/language/MCP tests",
      "pnpm test:knowledge:integration",
      "pnpm typecheck"
    ]
  },
  {
    "area": "Renderer lifecycle / route cache",
    "risk": "stale workspace state, retained workers, or cached routes crossing workspace boundaries",
    "patterns": [
      "^src/app/AppCachedOutlet",
      "^src/app/routeCachePolicy",
      "^src/app/scheduleEditorRuntimePreload",
      "^src/app/useAppLayoutOutlet",
      "^src/services/boundedWorkerPool"
    ],
    "checks": ["route cache and worker lifecycle tests", "pnpm test:renderer:e2e", "pnpm typecheck"]
  },
  {
    "area": "Document preview lifecycle",
    "risk": "preview data crossing workspaces, stale async work, or retained document resources",
    "patterns": [
      "^src/components/previews/",
      "^src/services/preview",
      "^src/services/fsApi",
      "^src/types/workspace.*Preview"
    ],
    "checks": ["document preview component tests", "pnpm test:renderer:e2e", "pnpm typecheck"]
  },
  {
    "area": "Build/package",
    "risk": "CI/task drift, missing resources, oversized bundles, asset drift, or broken package metadata",
    "patterns": [
      "^\\.github/workflows/",
      "^moon\\.yml$",
      "^package\\.json$",
      "^pnpm-lock\\.yaml$",
      "^resources/",
      "^scripts/",
      "^vite",
      "^tsconfig"
    ],
    "checks": ["pnpm typecheck", "pnpm lint", "pnpm build:renderer", "pnpm tauri:check"]
  },
  {
    "area": "i18n",
    "risk": "untranslated menu/settings text or renderer/native locale mismatch",
    "patterns": ["^src-tauri/src/desktop/menu", "^src/i18n/"],
    "checks": ["locale/resource tests", "affected UI tests"]
  },
  {
    "area": "Quality gates",
    "risk": "quality checklist drift, missing boundary guard, or stale verification guidance",
    "patterns": ["^docs/quality-gates\\.md$", "^scripts/quality-impact\\.ts$", "^src/quality/"],
    "checks": ["quality gate tests", "pnpm quality:impact", "pnpm lint"]
  }
]
