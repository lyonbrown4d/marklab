{
  "name": "marklab",
  "private": true,
  "version": "0.2.8",
  "description": "Desktop-first local Markdown workspace for Marklab.",
  "author": "Marklab",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^25.0.0"
  },
  "scripts": {
    "dev": "moon run desktop:tauri-dev",
    "build": "moon run desktop:build",
    "build:analyze": "pnpm typecheck && vite build --mode analyze",
    "build:compiler": "pnpm typecheck && vite build --mode compiler",
    "build:design-preview": "vite build --config vite.design-preview.config.ts",
    "icons:generate": "node --experimental-strip-types scripts/generate-app-icons.ts",
    "desktop:prepare": "moon run desktop:prepare",
    "desktop:prepare:dev": "moon run desktop:prepare-dev",
    "dev:desktop": "moon run desktop:tauri-dev",
    "build:desktop": "moon run desktop:build",
    "package": "moon run desktop:package",
    "dist": "moon run desktop:dist",
    "dist:win": "moon run desktop:dist-win",
    "dist:mac": "moon run desktop:dist-mac",
    "dist:linux": "moon run desktop:dist-linux",
    "lint": "moon run desktop:lint",
    "typecheck": "moon run desktop:typecheck",
    "quality:impact": "node --experimental-strip-types scripts/quality-impact.ts",
    "quality:line-limits": "node --experimental-strip-types scripts/check-source-line-limits.ts",
    "typecheck:scripts": "node node_modules/typescript/bin/tsc6 -p tsconfig.scripts.json",
    "test": "moon run desktop:test",
    "test:coverage:critical": "pnpm bindings:generate && vitest run --coverage --maxWorkers=2",
    "test:knowledge:integration": "pnpm tauri:test --lib analysis::",
    "test:ui": "pnpm bindings:generate && vitest run .integration.test.",
    "test:perf": "pnpm build:renderer && pnpm test:perf:run",
    "test:perf:all": "pnpm build:renderer && pnpm test:perf:all:run",
    "test:perf:all:run": "pnpm exec playwright test --config playwright.renderer.config.ts --project renderer-gpu --project software-rendering",
    "test:perf:run": "pnpm exec playwright test --config playwright.renderer.config.ts --project renderer-gpu",
    "test:perf:software": "pnpm build:renderer && pnpm test:perf:software:run",
    "test:perf:software:run": "pnpm exec playwright test --config playwright.renderer.config.ts --project software-rendering",
    "test:perf:ci": "pnpm test:perf:software",
    "test:integration": "pnpm test:ui && pnpm tauri:test && pnpm test:renderer:e2e && pnpm test:tauri:e2e",
    "test:watch": "pnpm bindings:generate && vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "prepare": "husky install",
    "moon": "moon",
    "check": "moon run desktop:check",
    "lint:check": "moon run desktop:lint",
    "dev:renderer": "pnpm bindings:generate && vite --mode tauri",
    "build:renderer": "node --experimental-strip-types scripts/build-renderer.ts",
    "tauri:dev": "moon run desktop:tauri-dev",
    "tauri:build": "moon run desktop:build",
    "tauri:check": "pnpm icons:generate && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:test": "pnpm icons:generate && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:bundle": "moon run desktop:package",
    "test:renderer:e2e": "pnpm build:renderer && pnpm test:renderer:e2e:run",
    "test:renderer:e2e:run": "pnpm exec playwright test --config playwright.renderer.config.ts --project smoke",
    "build:tauri:e2e": "tauri build --debug --no-bundle --features e2e-testing --config e2e/tauri/tauri.e2e.conf.json",
    "test:tauri:e2e:run": "node --experimental-strip-types e2e/tauri/run.ts",
    "test:tauri:e2e": "pnpm build:tauri:e2e && pnpm test:tauri:e2e:run",
    "bindings:generate": "node --experimental-strip-types scripts/generate-desktop-bindings.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
