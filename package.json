{
  "name": "marklab",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop-first local Markdown workspace for Marklab.",
  "author": "Marklab",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22 <=25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@homebridge/node-pty-prebuilt-multiarch",
      "@parcel/watcher",
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract"
    ],
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "pnpm electron:build",
    "electron:dev": "vite --mode electron",
    "native:rebuild": "node scripts/rebuild-node-pty.mjs",
    "electron:build": "pnpm native:rebuild && vite build --mode electron",
    "electron:start": "pnpm electron:build && electron .",
    "dev:desktop": "pnpm native:rebuild && pnpm electron:dev",
    "build:desktop": "pnpm electron:build",
    "package": "pnpm build:desktop && electron-builder --dir --publish never",
    "dist": "pnpm build:desktop && electron-builder --publish never",
    "dist:win": "pnpm build:desktop && electron-builder --win --publish never",
    "dist:mac": "pnpm build:desktop && electron-builder --mac --publish never",
    "dist:linux": "pnpm build:desktop && electron-builder --linux --publish never",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "build": {
    "appId": "app.marklab.desktop",
    "productName": "Marklab",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**/*",
      "node_modules/node-pty/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "protocols": [
      {
        "name": "Marklab Deep Links",
        "schemes": [
          "marklab",
          "marko"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "Marklab Maintainers <lyonbrown4d@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.12.3",
    "@dagrejs/dagre": "^3.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@milkdown/core": "^7.21.2",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/preset-gfm": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/theme-nord": "^7.21.2",
    "@monaco-editor/react": "^4.7.0",
    "@prosemirror-adapter/react": "^0.5.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@uiw/codemirror-theme-eclipse": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "ahooks": "^3.9.7",
    "awilix": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "fuse.js": "^7.4.2",
    "github-slugger": "^2.0.0",
    "i18next": "^26.3.0",
    "immer": "^11.1.8",
    "keepalive-for-react": "^5.0.11",
    "kysely": "^0.29.2",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.17.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "mitt": "3.0.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-arborist": "^3.8.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.16.0",
    "react-scan": "^0.5.7",
    "react-virtualized-auto-sizer": "^2.0.3",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "42.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "unplugin-turbo-console": "^2.3.2",
    "vite": "^8.0.16",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
