    "rxjs": "^7.8.2",
    "simple-git": "^4.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vscode-languageserver-textdocument": "^1.0.15",
