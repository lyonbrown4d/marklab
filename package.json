{
  "name": "marklab",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop-first local Markdown workspace for Marklab.",
  "author": "Marklab",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22 <=25"
  },
  "pnpm": {
    "overrides": {
      "@excalidraw/excalidraw>nanoid": "3.3.18",
      "@excalidraw/mermaid-to-excalidraw>nanoid": "5.1.16",
      "@codemirror/view": "6.43.13",
      "lodash-es": "4.18.1"
    },
    "onlyBuiltDependencies": [
      "@homebridge/node-pty-prebuilt-multiarch",
      "@parcel/watcher",
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract",
      "node-llama-cpp"
    ]
  },
  "scripts": {
    "dev": "moon run desktop:electron-dev",
    "build": "moon run desktop:build",
    "build:analyze": "pnpm typecheck && vite build --mode analyze",
    "build:compiler": "pnpm typecheck && vite build --mode compiler",
    "icons:generate": "node --experimental-strip-types scripts/generate-app-icons.ts",
    "desktop:prepare": "moon run desktop:prepare",
    "desktop:prepare:dev": "moon run desktop:prepare-dev",
    "build:electron": "moon run desktop:electron-build",
    "electron:dev": "moon run desktop:electron-dev",
    "electron:build": "moon run desktop:electron-build",
    "electron:start": "pnpm electron:build && electron .",
    "dev:desktop": "moon run desktop:electron-dev",
    "build:desktop": "moon run desktop:build",
    "package": "moon run desktop:package",
    "dist": "moon run desktop:dist",
    "dist:win": "moon run desktop:dist-win",
    "dist:mac": "moon run desktop:dist-mac",
    "dist:linux": "moon run desktop:dist-linux",
    "lint": "moon run desktop:lint",
    "typecheck": "moon run desktop:typecheck",
    "quality:impact": "node --experimental-strip-types scripts/quality-impact.ts",
    "typecheck:scripts": "pnpm exec tsc -p tsconfig.scripts.json",
    "test": "moon run desktop:test",
    "test:knowledge:integration": "moon run desktop:test-knowledge-integration",
    "test:ui": "vitest run .integration.test.",
    "test:electron": "pnpm test:electron:build && pnpm test:electron:run",
    "test:electron:build": "pnpm icons:generate && pnpm exec vite build --mode electron",
    "test:electron:run": "node --experimental-strip-types scripts/run-electron-e2e.ts",
    "test:perf": "pnpm test:electron:build && pnpm test:perf:run",
    "test:perf:all": "pnpm test:electron:build && pnpm test:perf:all:run",
    "test:perf:all:run": "pnpm exec playwright test --config playwright.performance.config.ts",
    "test:perf:run": "pnpm exec playwright test --config playwright.performance.config.ts --project native-gpu",
    "test:perf:software": "pnpm test:electron:build && pnpm test:perf:software:run",
    "test:perf:software:run": "pnpm exec playwright test --config playwright.performance.config.ts --project software-rendering",
    "test:integration": "pnpm test:ui && pnpm test:electron",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "prepare": "husky install",
    "moon": "moon",
    "check": "moon run desktop:check",
    "lint:check": "moon run desktop:lint"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "build": {
    "appId": "app.marklab.desktop",
    "productName": "Marklab",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@parcel/watcher*/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/picomatch/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}-metal/**/*",
      "node_modules/@reflink/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icons/**/*",
      "!node_modules/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*",
      "node_modules/@parcel/watcher/**/*",
      "node_modules/@parcel/watcher-*/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/picomatch/**/*",
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}-metal/**/*",
      "node_modules/{@huggingface,@isaacs,@kwsites,@reflink,@simple-git,@tinyhttp}/**/*",
      "node_modules/{ansi-escapes,ansi-regex,ansi-styles,async-retry,bytes,chalk,chmodrp,chownr,ci-info,cli-cursor,cli-spinners,cliui,cmake-js,color-convert,color-name,commander,cross-spawn,debug,deep-extend,emoji-regex,env-var,escalade,eventemitter3,filename-reserved-regex,filenamify,fs-extra,get-caller-file,graceful-fs,ignore,ini,ipull,is-fullwidth-code-point,is-interactive,is-unicode-supported,isexe,jsonfile,lifecycle-utils,lodash.debounce,log-symbols,lowdb,mimic-function,minimist,minipass,minizlib,ms,nanoid,node-api-headers,onetime,ora,parse-ms,path-key,pretty-bytes,pretty-ms,proper-lockfile,rc,require-directory,restore-cursor,retry,semver,shebang-command,shebang-regex,signal-exit,simple-git,sleep-promise,slice-ansi,stdin-discarder,stdout-update,steno,string-width,strip-ansi,strip-json-comments,tar,universalify,url-join,validate-npm-package-name,which,wrap-ansi,y18n,yallist,yargs,yargs-parser,yoctocolors}/**/*",
      "!dist/**/*.map",
      "!dist-electron/**/*.map",
      "!node_modules/node-llama-cpp/llama/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "publish": [
      {
        "provider": "github",
        "publishAutoUpdate": true,
        "releaseType": "release",
        "tagNamePrefix": "app-v"
      }
    ],
    "protocols": [
      {
        "name": "Marklab Deep Links",
        "schemes": [
          "marklab"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "resources/icons/marklab.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "shortcutName": "Marklab",
      "uninstallDisplayName": "Marklab"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icons/marklab.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icons/marklab.png",
      "category": "Office",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ],
      "maintainer": "Marklab Maintainers <lyonbrown4d@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.60",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "^3.1.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@milkdown/core": "^7.22.2",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/plugin-listener": "^7.22.2",
    "@milkdown/preset-commonmark": "^7.22.2",
    "@milkdown/preset-gfm": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@milkdown/theme-nord": "^7.22.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@monaco-editor/react": "^4.7.0",
    "@parcel/watcher": "2.6.0",
    "@prosemirror-adapter/react": "^0.5.5",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/codemirror-theme-eclipse": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "ahooks": "^3.10.0",
    "ai": "^7.0.123",
    "awilix": "^13.0.5",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "detect-libc": "^2.1.2",
    "diff": "^9.0.0",
    "docx": "^9.8.1",
    "docx-preview": "^0.4.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "elkjs": "^0.12.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "i18next": "26.4.2",
    "immer": "^11.1.18",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "keepalive-for-react": "^6.0.0",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.48.0",
    "markdown-it": "^15.0.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.0.0",
    "minisearch": "^7.2.0",
    "mitt": "3.0.1",
    "monaco-editor": "^0.57.0",
    "node-addon-api": "^8.9.2",
    "node-llama-cpp": "3.22.1",
    "p-limit": "^7.3.3",
    "pathe": "^2.0.3",
    "pdfjs-dist": "6.3.289",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
