    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-pdf": "10.4.1",
    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "^7.18.1",
    "react-scan": "^0.5.7",
