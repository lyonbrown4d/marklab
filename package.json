{
  "name": "marklab",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop-first local Markdown workspace for Marklab.",
  "author": "Marklab",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22 <=25"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/view": "6.43.5"
    },
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "@homebridge/node-pty-prebuilt-multiarch",
      "@parcel/watcher",
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "dev": "moon run desktop:electron-dev",
    "dev:web": "moon run desktop:web-dev",
    "build": "moon run desktop:build",
    "build:web": "moon run desktop:web-build",
    "build:analyze": "pnpm typecheck && vite build --mode analyze",
    "build:compressed": "pnpm typecheck && vite build --mode compressed",
    "build:compiler": "pnpm typecheck && vite build --mode compiler",
    "icons:generate": "node --experimental-strip-types scripts/generate-app-icons.ts",
    "knowledge:build": "node --experimental-strip-types scripts/build-knowledge-engine.ts --profile release",
    "knowledge:build:dev": "node --experimental-strip-types scripts/build-knowledge-engine.ts --profile debug",
    "knowledge:build:force": "node --experimental-strip-types scripts/build-knowledge-engine.ts --profile release --force",
    "knowledge:proto:lint": "buf lint",
    "knowledge:proto:gen": "buf generate knowledge-engine/proto",
    "desktop:prepare": "moon run desktop:prepare",
    "desktop:prepare:dev": "moon run desktop:prepare-dev",
    "build:electron": "moon run desktop:electron-build",
    "electron:dev": "moon run desktop:electron-dev",
    "electron:build": "moon run desktop:electron-build",
    "electron:start": "pnpm electron:build && electron .",
    "dev:desktop": "moon run desktop:electron-dev",
    "build:desktop": "moon run desktop:build",
    "package": "moon run desktop:package",
    "dist": "moon run desktop:dist",
    "dist:win": "moon run desktop:dist-win",
    "dist:mac": "moon run desktop:dist-mac",
    "dist:linux": "moon run desktop:dist-linux",
    "lint": "moon run desktop:lint",
    "typecheck": "moon run desktop:typecheck",
    "quality:impact": "node --experimental-strip-types scripts/quality-impact.ts",
    "typecheck:scripts": "pnpm exec tsc -p tsconfig.scripts.json",
    "test": "moon run desktop:test",
    "test:knowledge:integration": "moon run desktop:test-knowledge-integration",
    "test:ui": "vitest run .integration.test.",
    "test:electron": "pnpm test:electron:build && node -e \"setTimeout(() => process.exit(0), 3000)\" && pnpm test:electron:run",
    "test:electron:build": "pnpm icons:generate && pnpm exec vite build --mode electron",
    "test:electron:run": "node --experimental-strip-types scripts/run-electron-e2e.ts",
    "test:integration": "pnpm test:ui && pnpm test:electron",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "prepare": "husky install",
    "moon": "moon",
    "check": "moon run desktop:check",
    "lint:check": "moon run desktop:lint"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "build": {
    "appId": "app.marklab.desktop",
    "productName": "Marklab",
    "asar": true,
    "asarUnpack": [
      "node_modules/@parcel/watcher*/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/picomatch/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icons/**/*",
      "!node_modules/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*",
      "node_modules/@parcel/watcher/**/*",
      "node_modules/@parcel/watcher-*/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/picomatch/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "publish": [
      {
        "provider": "github",
        "publishAutoUpdate": true,
        "releaseType": "release",
        "tagNamePrefix": "app-v"
      }
    ],
    "protocols": [
      {
        "name": "Marklab Deep Links",
        "schemes": [
          "marklab"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "resources/icons/marklab.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "shortcutName": "Marklab",
      "uninstallDisplayName": "Marklab"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icons/marklab.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icons/marklab.png",
      "category": "Office",
      "maintainer": "Marklab Maintainers <lyonbrown4d@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@dagrejs/dagre": "^3.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@grpc/grpc-js": "^1.14.4",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@hookform/resolvers": "^5.4.0",
    "@milkdown/core": "^7.21.2",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/preset-gfm": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/theme-nord": "^7.21.2",
    "@monaco-editor/react": "^4.7.0",
    "@parcel/watcher": "2.5.6",
    "@prosemirror-adapter/react": "^0.5.3",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.3.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toggle": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@uiw/codemirror-theme-eclipse": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.11.1",
    "ahooks": "^3.9.7",
    "awilix": "^13.0.5",
    "axios": "1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "detect-libc": "^2.0.3",
    "diff": "^9.0.0",
