{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Marklab E2E",
  "identifier": "app.marklab.tauri.desktop.e2e",
  "build": {
    "devUrl": null
  },
  "bundle": {
    "active": true
  },
  "app": {
    "security": {
      "capabilities": [
        "desktop",
        {
          "identifier": "e2e-window-geometry",
          "description": "Native geometry for ChromeDriver attach; E2E configuration only.",
          "webviews": ["main", "workspace-*", "opening-*"],
          "permissions": ["core:window:allow-set-position", "core:window:allow-set-size"]
        }
      ]
    }
  }
}
