---
import { Image } from 'astro:assets'
import SiteLayout from '@site/layouts/SiteLayout.astro'
import DownloadSection from '@site/components/DownloadSection.astro'
import appEditor from '@site/assets/app-editor.png'
import appGraph from '@site/assets/app-workspace-map.png'
import { homeCopy, type Locale } from '#site/lib/homeCopy'
import { localPath } from '#site/lib/links'
import { releases } from '#site/lib/siteData'
import { getDownload } from '#site/lib/downloads'
import { repository, releasesUrl } from '#site/lib/releases'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = homeCopy[locale]
const base = import.meta.env.BASE_URL
const guide = (page: string) => localPath(base, `${locale === 'en' ? 'en/' : ''}guide/${page}/`)
const primary = getDownload(releases, 'mac-arm64')
---

<SiteLayout locale={locale}>
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <header class="flex min-h-16 items-center justify-between gap-5 border-b border-rule py-4 text-sm">
      <a href={localPath(base, locale === 'en' ? 'en/' : '')} aria-label="Marklab">
        <img src={localPath(base, 'favicon.svg')} width="28" height="28" alt="" />
      </a>
      <nav
        aria-label={locale === 'en' ? 'Main navigation' : '主导航'}
        class="flex flex-wrap items-center gap-5"
      >
        <a href={guide('getting-started')} class="hover:text-accent">
          {copy.guide}
        </a>
        <a href={repository} class="hover:text-accent">
          GitHub
        </a>
        <a
          href={localPath(base, copy.otherLanguagePath)}
          lang={locale === 'en' ? 'zh-CN' : 'en'}
          class="hover:text-accent"
        >
          {copy.otherLanguage}
        </a>
        <a href="#download" class="hover:text-accent">
          {copy.download}
        </a>
      </nav>
    </header>
    <main id="main">
      <section aria-labelledby="hero-title" class="pt-8 sm:pt-10">
        <div class="flex items-baseline gap-3">
          <h1 id="hero-title" class="text-3xl font-semibold tracking-tight">
            Marklab
          </h1>
          {primary && (
            <a href={primary.releaseUrl} class="text-sm text-muted hover:text-accent">
              v{primary.version}
            </a>
          )}
        </div>
        <p class="mt-3 text-base leading-7 text-muted">{copy.intro}</p>
        <div class="mt-5 mb-7 flex flex-wrap items-center gap-5 text-sm">
          <a
            href={primary?.url ?? releasesUrl}
            class="rounded bg-accent px-4 py-2.5 font-medium text-white hover:bg-blue-700"
          >
            {primary ? copy.primary : copy.download}
          </a>
          <a href="#download" class="text-accent underline underline-offset-4">
            {copy.other}
          </a>
        </div>
        <Image
          src={appEditor}
          alt={copy.screenshot}
          width={1440}
          widths={[640, 960, 1440]}
          sizes="(max-width: 768px) 100vw, 960px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full rounded border border-rule"
        />
      </section>
      <section id="features" aria-labelledby="features-title" class="py-8">
        <h2 id="features-title" class="mb-4 text-xl font-semibold">
          {copy.features}
        </h2>
        <dl class="space-y-3 text-sm leading-6">
          {copy.featureRows.map((feature) => (
            <div class="grid grid-cols-[5rem_1fr] gap-3 sm:grid-cols-[7rem_1fr]">
              <dt>
                <a href={guide(feature.path)} class="text-accent hover:underline">
                  {feature.label}
                </a>
              </dt>
              <dd class="text-muted">{feature.text}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section aria-labelledby="graph-title" class="pb-8">
        <h2 id="graph-title" class="mb-4 text-xl font-semibold">
          {copy.graph}
        </h2>
        <Image
          src={appGraph}
          alt={copy.graphScreenshot}
          width={1440}
          widths={[640, 960, 1440]}
          sizes="(max-width: 768px) 100vw, 960px"
          format="webp"
          loading="lazy"
          class="h-auto w-full rounded border border-rule"
        />
      </section>
      <DownloadSection locale={locale} />
    </main>
    <footer class="flex flex-wrap gap-x-5 gap-y-2 border-t border-rule py-5 text-xs text-muted">
      <a href={repository} class="hover:text-accent">
        {copy.source}
      </a>
      <a href={`${repository}/issues`} class="hover:text-accent">
        {copy.issues}
      </a>
      <a href={releases[0]?.html_url ?? releasesUrl} class="hover:text-accent">
        {copy.releaseNotes}
      </a>
    </footer>
  </div>
</SiteLayout>
