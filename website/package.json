{
  "name": "@marklab/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^25.0.0"
  },
  "imports": {
    "#site/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "releases:sync": "node --env-file-if-exists=.env --experimental-strip-types scripts/sync-releases.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.7",
    "@astrojs/starlight-tailwind": "5.0.0",
    "astro": "7.4.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  }
}
