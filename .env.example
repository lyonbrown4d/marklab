# pnpm dev starts the official standalone React DevTools before the Tauri renderer.
MARKLAB_REACT_DEVTOOLS=true
MARKLAB_REACT_DEVTOOLS_PORT=8097
MARKLAB_REACT_DEVTOOLS_TIMEOUT_MS=20000

# Optional AI credentials are read by the native process, never VITE_* variables.
# Existing process variables take precedence over this development-only file.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.5-flash-lite
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
